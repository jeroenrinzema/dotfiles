[gpg]
	format = ssh
[gpg "ssh"]
	# Linux/Coder uses the key from SSH_AUTH_SOCK; macOS overrides the signer.
	program = ssh-keygen
[commit]
	gpgSign = true
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[merge]
	conflictStyle = diff3
[diff]
	colorMoved = default
